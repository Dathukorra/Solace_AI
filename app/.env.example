# Solace AI - Expo Mobile App Environment Variables

# URL pointing to the Solace AI backend Express server (/api prefix).
# When testing on a real physical phone via Expo Go, replace localhost with your computer's local Wi-Fi IP address:
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
#
# Defaults for Simulators/Emulators:
# - iOS Simulator: http://localhost:5000/api
# - Android Emulator: http://10.0.2.2:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

