NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solace_ai?schema=public"
CORS_ORIGIN="*"
JWT_ACCESS_SECRET="change-me-must-be-at-least-32-characters-long"
JWT_REFRESH_SECRET="change-me-must-be-at-least-32-characters-long"

# Password reset. Tokens are single-use and expire after 30 minutes.
# Outside production the API also returns the reset token so the app can show
# the reset flow without an email provider configured.
PASSWORD_RESET_TTL_MINUTES="30"
PASSWORD_RESET_URL_BASE="solace://reset-password"

ANTHROPIC_API_KEY="sk-ant-api..."
ANTHROPIC_MODEL="claude-sonnet-5-5"
ANTHROPIC_CHEAP_MODEL="claude-haiku-5-5"

# Optional: Hugging Face Inference Providers.
# Requires a token and available Inference Providers credits (not free for new free accounts).
HF_TOKEN=""
HF_MODEL="openai/gpt-oss-120b:fastest"
HF_BASE_URL="https://router.huggingface.co/v1"

# Keyless free demo fallback, used automatically when ANTHROPIC_API_KEY and HF_TOKEN are empty.
# Set POLLINATIONS_ENABLED="false" to disable it and use the static fallback reply instead.
POLLINATIONS_ENABLED="true"
POLLINATIONS_MODEL="openai"
POLLINATIONS_BASE_URL="https://text.pollinations.ai/openai"
POLLINATIONS_TOKEN=""
